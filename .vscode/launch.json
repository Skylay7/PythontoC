{
    "version": "2.0.0",
    "configurations": [
        {
            "name": "Run pytoc",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/pytoc.exe",
            "args": [
                "src/test/test2.py",
                "-o",
                "output.c"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\MinGW\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build pytoc"
        }
    ]
}